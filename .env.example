# Required vendor credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
INBOXKIT_API_KEY=
SMARTLEAD_API_KEY=
# Required to export Microsoft (Outlook) mailboxes into Smartlead via InboxKit OAuth
SMARTLEAD_LOGIN=
SMARTLEAD_PASSWORD=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Public URL of this service (used for InboxKit webhooks). On Railway: https://your-service.up.railway.app
PUBLIC_BASE_URL=

# Optional: defaults / contact used when registering domains with InboxKit forwarding
DOMAIN_FORWARDING_BASE_URL=
REGISTRANT_FIRST_NAME=
REGISTRANT_LAST_NAME=
REGISTRANT_EMAIL=
REGISTRANT_PHONE=
REGISTRANT_ORG=
REGISTRANT_ADDRESS1=
REGISTRANT_CITY=
REGISTRANT_STATE=
REGISTRANT_COUNTRY=US
REGISTRANT_POSTAL=

# Warmup defaults applied in Smartlead
WARMUP_TOTAL_PER_DAY=20
WARMUP_DAILY_RAMPUP=5
WARMUP_REPLY_RATE_PERCENTAGE=30
MAX_EMAIL_PER_DAY=40

# Server
PORT=8080
DATA_DIR=./data
