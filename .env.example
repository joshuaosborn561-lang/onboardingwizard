# Required vendor credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
INBOXKIT_API_KEY=
SMARTLEAD_API_KEY=
# Base login for new Smartlead client workspaces (unique local-part variants are generated)
SMARTLEAD_CLIENT_EMAIL=joshosb1996@gmail.com
# Required to export Microsoft (Outlook) mailboxes into Smartlead via InboxKit OAuth
SMARTLEAD_LOGIN=
SMARTLEAD_PASSWORD=
# From the NEW dedicated "SalesGlider Onboarding" Slack app (not ai_reply_handler2)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Signing secret from that same new app. Required for in-channel buttons.
SLACK_SIGNING_SECRET=
# Optional override for HMAC on button tokens; defaults to SLACK_SIGNING_SECRET then SLACK_BOT_TOKEN
SLACK_ACTION_SECRET=
# Slack Connect channel shared with InboxKit support (bot must be a member)
SLACK_INBOXKIT_CHANNEL_ID=
# Hours an InboxKit-owned in-flight mailbox/export can sit before we ping that channel
INBOXKIT_STUCK_HOURS=12

# Public URL of this service (used for InboxKit webhooks). On Railway: https://your-service.up.railway.app
PUBLIC_BASE_URL=

# Optional: defaults / contact used when registering domains with InboxKit forwarding
DOMAIN_FORWARDING_BASE_URL=
REGISTRANT_FIRST_NAME=
REGISTRANT_LAST_NAME=
REGISTRANT_EMAIL=
REGISTRANT_PHONE=
REGISTRANT_ORG=
REGISTRANT_ADDRESS1=
REGISTRANT_CITY=
REGISTRANT_STATE=
REGISTRANT_COUNTRY=US
REGISTRANT_POSTAL=

# Warmup defaults applied in Smartlead
WARMUP_TOTAL_PER_DAY=20
WARMUP_DAILY_RAMPUP=5
WARMUP_REPLY_RATE_PERCENTAGE=30
MAX_EMAIL_PER_DAY=40

# Server
PORT=8080
DATA_DIR=./data
# Inventory sweep / retry stay dry-run unless this is false AND the caller passes --live / dryRun=false
SWEEP_DRY_RUN=true
# Optional shared secret for POST /api/cron/sweep and /api/cron/retry
CRON_SECRET=
